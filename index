import asyncio
import logging
from aiogram import Bot, Dispatcher, types
from aiogram.filters import Command
from aiogram.types import WebAppInfo, InlineKeyboardMarkup, InlineKeyboardButton

# Вставь сюда токен своего бота, полученный от @BotFather
TOKEN = "YOUR_BOT_TOKEN_HERE"

async def start_cmd(message: types.Message):
    # Кнопка для запуска мини-приложения Rykov Kombat
    keyboard = InlineKeyboardMarkup(
        inline_keyboard=[
            [
                InlineKeyboardButton(
                    text="💪 Запустить Rykov Kombat", 
                    web_app=WebAppInfo(url="https://твой-сайт.рф/index.html") # Ссылка на твой хостинг с фронтендом
                )
            ]
        ]
    )
    await message.answer(
        "Добро пожаловать в **Rykov Kombat**[span_2](start_span)[span_2](end_span)!\ТАпай по экрану, прокачивай бицепсы и зарабатывай коины!",
        reply_markup=keyboard,
        parse_mode="Markdown"
    )

async def main():
    logging.basicConfig(level=logging.INFO)
    bot = Bot(token=TOKEN)
    dp = Dispatcher()
    dp.message.register(start_cmd, Command("start"))
    
    print("Бот Rykov Kombat запущен!")
    await dp.start_polling(bot)

if __name__ == "__main__":
    asyncio.run(main())
